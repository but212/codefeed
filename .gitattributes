# Default line ending handling (normalize to LF on commit)
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf diff=rust
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.lock text eol=lf

# Common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tar.gz binary
*.zip binary
